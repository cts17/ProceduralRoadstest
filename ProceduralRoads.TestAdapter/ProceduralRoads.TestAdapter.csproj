<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../ProceduralRoads/environment.props" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><LangVersion>10</LangVersion><Nullable>enable</Nullable>
    <CliDll Condition="'$(CliDll)' == ''">../../cli-test-framework/bin/Release/valheimCLI.dll</CliDll>
    <RoadsDll Condition="'$(RoadsDll)' == ''">../ProceduralRoads/bin/Debug/ProceduralRoads.dll</RoadsDll>
    <Version>0.1.0</Version><DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="valheimCLI"><HintPath>$(CliDll)</HintPath><Private>false</Private></Reference>
    <Reference Include="ProceduralRoads"><HintPath>$(RoadsDll)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><Compile Include="../ProceduralRoads.TestFixtures/FlatRoadFixture.cs" Link="Fixtures/FlatRoadFixture.cs" /></ItemGroup>
</Project>
